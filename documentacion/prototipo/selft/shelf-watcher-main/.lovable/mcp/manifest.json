{
  "version": 1,
  "sdk_version": "0.20.0",
  "path": "/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "minimarket-central-mcp",
      "version": "0.1.0",
      "title": "MiniMarket Central MCP"
    },
    "tools": [
      {
        "name": "list_products",
        "title": "List catalog products",
        "description": "List products from the minimarket template catalog. Optionally filter by category or stock status (ok, low, critical, empty).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "category": {
              "description": "Filter by category (e.g. Bebidas, Snacks).",
              "type": "string"
            },
            "status": {
              "description": "Filter by computed stock status.",
              "type": "string",
              "enum": [
                "ok",
                "low",
                "critical",
                "empty"
              ]
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_product",
        "title": "Get product details",
        "description": "Fetch a single product from the template catalog by id.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "description": "Product id, e.g. 'p01'."
            }
          },
          "required": [
            "id"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "low_stock_alerts",
        "title": "Low stock alerts",
        "description": "Return products that need restocking: those with status 'empty', 'critical', or 'low'.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "includeLow": {
              "description": "Include products with 'low' status (default true).",
              "type": "boolean"
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "inventory_summary",
        "title": "Inventory summary",
        "description": "Aggregate KPIs of the template inventory: total SKUs, total units, valuation, and counts per stock status and category.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_shelves",
        "title": "List shelves",
        "description": "List the default shelf layout with the products currently placed in each slot and their stock status.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      }
    ]
  }
}
